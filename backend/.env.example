DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Optional Redis cache for analytics (30-second TTL); unavailable Redis falls back to the database.
REDIS_URL=redis://localhost:6379/0
# Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
# Exact, comma-separated subject codes that include a weekly practical meeting.
PRACTICAL_SUBJECT_CODES=
# Đặt true khi chạy HTTPS (production)
COOKIE_SECURE=false

# Kh�a AES-256 m� h�a cookie Hash. Sinh b?ng: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
HASH_KEY=