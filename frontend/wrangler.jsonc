{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gppm-2026",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_ORIGIN": "https://be-3u2p.onrender.com"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
